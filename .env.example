LLAMALENS_DATA_DIR=/var/lib/llama-lens
LLAMALENS_FRONTEND_DIST=/opt/llama-lens/frontend/dist
LLAMALENS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional authentication. Keep this value outside Git and rotate it if exposed.
# Loopback requests remain exempt unless LLAMALENS_REQUIRE_AUTH=1.
LLAMALENS_API_TOKEN=replace-with-a-long-random-token
LLAMALENS_REQUIRE_AUTH=0

# Optional system and queue tuning.
LLAMALENS_SYSTEMD_DIR=/etc/systemd/system
LLAMALENS_SSE_KEEPALIVE_S=5
LLAMALENS_SSE_QUEUE_MAXSIZE=16
LLAMALENS_QUEUE_FAILURE_THRESHOLD=5
LLAMALENS_QUEUE_ERROR_COOLDOWN_MS=30000
LLAMALENS_DOWNLOAD_COMMIT_INTERVAL_MS=2000
LLAMALENS_DOWNLOAD_COMMIT_INTERVAL_BYTES=16777216

# Frontend build-time overrides (set before `npm run build`).
# VITE_API_BASE=/api/v1
# VITE_LLAMALENS_SSE_RECONNECT_MS=3000
# VITE_LLAMALENS_FALLBACK_POLL_MS=5000
# VITE_LLAMALENS_FALLBACK_RUNNING_POLL_MS=1000
